#!/usr/bin/env bash
# Único comando que a chave SSH do GitHub Actions pode correr (authorized_keys: command="…",restrict).
# Aceita apenas: status · backup · rollback · deploy <sha> <sha256> (artefacto no stdin).
set -euo pipefail
cmd=${SSH_ORIGINAL_COMMAND:-}
if [[ $cmd =~ ^deploy\ ([0-9a-f]{7,40})\ ([0-9a-f]{64})$ ]]; then
  exec sudo -n /usr/local/sbin/serrado deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
case "$cmd" in
  status | backup | rollback) exec sudo -n /usr/local/sbin/serrado "$cmd" ;;
  *) echo "Comando não permitido: ${cmd:0:60}" >&2; exit 2 ;;
esac
