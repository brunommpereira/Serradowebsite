#!/usr/bin/env bash
# Serrado FC — comando de operação do servidor (instalado em /usr/local/sbin/serrado pelo bootstrap.sh).
#
#   serrado status                    estado dos serviços, versão e cópias de segurança
#   serrado deploy <sha> <sha256>     instala uma versão (artefacto .tar.gz no stdin), migra a BD e troca
#   serrado rollback                  volta à versão anterior
#   serrado backup                    cópia da base de dados agora (local + externa, se configurada)
#   serrado restore <ficheiro.dump>   repõe uma cópia (pede confirmação)
#   serrado offsite-latest <pasta>    descarrega a cópia externa mais recente (restic)
#   serrado admin <email> "<nome>"    cria/repõe uma conta de administração
#   serrado content                   carrega o conteúdo inicial do site (só com o CMS vazio)
#   serrado logs [n]                  últimas linhas dos registos
#   serrado cf-ips                    atualiza a firewall e o Caddy com os IPs da Cloudflare
#   serrado oauth google|microsoft    ativa «Continuar com Google/Microsoft» (pede o Client ID e o secret)
#   serrado oauth google|microsoft off  desativa
#   serrado facebook                  liga a página de Facebook (publicações → notícias, eventos → eventos)
#   serrado facebook off              desliga
#   serrado facebook-sync             sincroniza agora
#   serrado payments                  liga os pagamentos online (Stripe) e as faturas-recibo (Moloni ON)
#   serrado payments off              desliga
#   serrado moloni-info               empresas, séries, artigos e métodos de pagamento do Moloni (para configurar)
#   serrado receipts                  emite agora as faturas-recibo em falta
#   serrado fees [AAAA-MM]            cria as mensalidades das escolas do mês
#   serrado email                     liga o envio de emails (Brevo): recuperar password, convites, registos
#   serrado email test <endereço>     envia um email de teste
#   serrado email off                 desliga
#
# O GitHub Actions só pode correr deploy, rollback, backup e status (ver serrado-ssh-gate).
set -euo pipefail

ROOT=${SERRADO_ROOT:-/opt/serrado}
ETC=${SERRADO_ETC:-/etc/serrado}
BACKUP_DIR=${SERRADO_BACKUP_DIR:-/var/backups/serrado}
SYSTEMCTL=${SERRADO_SYSTEMCTL:-systemctl}
APP_USER=${SERRADO_USER:-serrado}
DB_NAME=${SERRADO_DB:-serrado}
KEEP_RELEASES=5
KEEP_LOCAL_DAYS=14
SERVICES=(serrado-backend serrado-middleware)

die() { echo "✘ $*" >&2; exit 1; }
info() { echo "→ $*"; }
[ "$(id -u)" = 0 ] || [ -n "${SERRADO_TEST:-}" ] || die 'Corre com sudo.'

# Corre como o utilizador da aplicação, com as variáveis de /etc/serrado/serrado.env
as_app() { runuser -u "$APP_USER" -- bash -c 'set -a; . "$0"; set +a; exec "$@"' "$ETC/serrado.env" "$@"; }
as_postgres() { runuser -u postgres -- "$@"; }
current_release() { if [ -L "$ROOT/current" ]; then basename "$(readlink "$ROOT/current")"; else echo none; fi; }

# A API responde e é a versão esperada (e não um processo antigo que ainda esteja de pé)
health() {
  local want=${1:-} port=${MIDDLEWARE_PORT:-4000}
  for _ in $(seq 30); do
    if curl -fsS "http://127.0.0.1:$port/api/health" 2>/dev/null | grep -q "\"version\":\"${want}"; then return 0; fi
    sleep 2
  done
  return 1
}

switch_to() {
  local target=$1
  ln -sfn "$ROOT/releases/$target" "$ROOT/current.new"
  mv -Tf "$ROOT/current.new" "$ROOT/current"
  for s in "${SERVICES[@]}"; do $SYSTEMCTL restart "$s"; done
}

cmd_deploy() {
  local sha=${1:-} sum=${2:-}
  [[ $sha =~ ^[0-9a-f]{7,40}$ ]] || die 'Versão (sha) inválida.'
  [[ $sum =~ ^[0-9a-f]{64}$ ]] || die 'Checksum sha256 inválido.'
  mkdir -p "$ROOT/releases"
  local tmp="$ROOT/releases/.incoming-$sha.tgz" dir="$ROOT/releases/$sha"
  info "A receber a versão $sha"
  cat > "$tmp"
  echo "$sum  $tmp" | sha256sum -c --quiet - || { rm -f "$tmp"; die 'O artefacto chegou corrompido (sha256 diferente).'; }
  rm -rf "$dir.tmp" && mkdir -p "$dir.tmp"
  tar -xzf "$tmp" -C "$dir.tmp" --no-same-owner --no-same-permissions
  rm -f "$tmp"
  [ -f "$dir.tmp/services/pyproject.toml" ] && [ -f "$dir.tmp/services/requirements.txt" ] && [ -d "$dir.tmp/services/wheels" ] && [ -f "$dir.tmp/web/index.html" ] \
    || { rm -rf "$dir.tmp"; die 'Artefacto incompleto.'; }
  echo "$sha" > "$dir.tmp/REVISION"
  # As bibliotecas compiladas só servem para a versão do Python com que foram preparadas no GitHub
  local want have; have=$(python3 -c 'import sys; print(f"{sys.version_info[0]}.{sys.version_info[1]}")')
  want=$(cat "$dir.tmp/PYTHON" 2>/dev/null || echo "$have")
  if [ "$want" != "$have" ]; then
    rm -rf "$dir.tmp"; die "Esta versão foi preparada para o Python $want, mas a VPS tem o $have. No GitHub, cria a variável VPS_PYTHON=$have (Settings → Secrets and variables → Actions → Variables) e volta a fazer o deploy."
  fi
  rm -rf "$dir" && mv "$dir.tmp" "$dir"
  # Ambiente Python da versão: só as bibliotecas que vieram no artefacto, conferidas pelos hashes (sem acesso ao PyPI)
  info 'Dependências Python'
  if ! { python3 -m venv "$dir/services/.venv" \
      && "$dir/services/.venv/bin/pip" install -q --no-index --find-links "$dir/services/wheels" --require-hashes -r "$dir/services/requirements.txt" \
      && "$dir/services/.venv/bin/python" -m compileall -q "$dir/services/serrado"; }; then
    rm -rf "$dir"; die 'Não consegui instalar as dependências Python desta versão.'
  fi
  rm -rf "$dir/services/wheels"
  chmod -R u=rwX,go=rX "$dir"

  local previous; previous=$(current_release)
  if [ "$previous" = "$sha" ]; then info 'Esta versão já está ativa: só reinicio.'; fi

  # Cópia antes de migrar (se a BD já tiver dados)
  if as_postgres psql -d "$DB_NAME" -tAc "select to_regclass('public.schema_migrations')" 2>/dev/null | grep -q schema_migrations; then
    cmd_backup pre-deploy
  fi
  info 'Migrações da base de dados'
  (cd "$dir/services" && as_app .venv/bin/python -m serrado.db.migrate)

  info "A ativar $sha (anterior: $previous)"
  switch_to "$sha"
  if ! health "$sha"; then
    echo "✘ A nova versão não respondeu. A voltar a $previous." >&2
    if [ "$previous" != none ] && [ "$previous" != "$sha" ]; then switch_to "$previous"; fi
    journalctl -u serrado-middleware -u serrado-backend -n 40 --no-pager 2>/dev/null || true
    exit 1
  fi
  [ "$previous" != none ] && [ "$previous" != "$sha" ] && echo "$previous" > "$ROOT/previous"
  # Limpeza: mantém as últimas versões (nunca a atual nem a anterior)
  local keep_prev; keep_prev=$(cat "$ROOT/previous" 2>/dev/null || true)
  find "$ROOT/releases" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%T@ %f\n' | sort -rn | cut -d' ' -f2 | tail -n +$((KEEP_RELEASES + 1)) | while read -r old; do
    [ "$old" = "$sha" ] || [ "$old" = "$keep_prev" ] || rm -rf "${ROOT:?}/releases/$old"
  done
  echo "✔ Versão $sha ativa"
}

cmd_rollback() {
  local prev; prev=$(cat "$ROOT/previous" 2>/dev/null || true)
  [ -n "$prev" ] && [ -d "$ROOT/releases/$prev" ] || die 'Não há versão anterior guardada.'
  local cur; cur=$(current_release)
  info "A voltar de $cur para $prev (as migrações da BD não são revertidas)"
  switch_to "$prev"
  health "$prev" || die 'A versão anterior também não respondeu. Ver: serrado logs'
  echo "$cur" > "$ROOT/previous"
  echo "✔ Versão $prev ativa"
}

cmd_backup() {
  local tag=${1:-daily}
  mkdir -p "$BACKUP_DIR" && chmod 700 "$BACKUP_DIR"
  local file
  file="$BACKUP_DIR/serrado-$(date +%Y%m%d-%H%M%S)-$tag.dump"
  info "Cópia da base de dados ($tag)"
  (umask 077 && as_postgres pg_dump -Fc -d "$DB_NAME" > "$file.tmp")
  mv "$file.tmp" "$file"
  find "$BACKUP_DIR" -name 'serrado-*.dump' -mtime +"$KEEP_LOCAL_DAYS" -delete
  date +%s > "$BACKUP_DIR/.last-local"
  echo "✔ $file ($(du -h "$file" | cut -f1))"

  # Cópia externa cifrada (restic → Cloudflare R2, OVH Object Storage, Backblaze…)
  if [ -f "$ETC/backup.env" ] && grep -q '^RESTIC_REPOSITORY=.\+' "$ETC/backup.env"; then
    set -a; . "$ETC/backup.env"; set +a
    restic cat config >/dev/null 2>&1 || restic init
    restic backup --quiet --tag "$tag" --host serrado "$file"
    restic forget --quiet --host serrado --keep-daily 14 --keep-weekly 8 --keep-monthly 12 --prune
    date +%s > "$BACKUP_DIR/.last-offsite"
    echo '✔ Cópia externa (cifrada) enviada'
  else
    echo '! Sem cópia externa configurada (ver /etc/serrado/backup.env)'
  fi
}

cmd_restore() {
  local file=${1:-}
  [ -f "$file" ] || die "Ficheiro não encontrado: $file"
  if [ -z "${SERRADO_YES:-}" ]; then
    read -r -p "Repor $file por cima da base de dados atual? Escreve REPOR: " ok
    [ "$ok" = REPOR ] || die 'Cancelado.'
  fi
  cmd_backup pre-restore
  for s in "${SERVICES[@]}"; do $SYSTEMCTL stop "$s"; done
  as_postgres pg_restore --clean --if-exists --no-owner --role="$APP_USER" -d "$DB_NAME" < "$file"
  for s in "${SERVICES[@]}"; do $SYSTEMCTL start "$s"; done
  health "$(current_release)" && echo '✔ Reposto'
}

cmd_offsite_latest() {
  local out=${1:-/root/serrado-offsite}
  set -a; . "$ETC/backup.env"; set +a
  mkdir -p "$out" && chmod 700 "$out"
  restic restore latest --host serrado --target "$out"
  find "$out" -name '*.dump' | sort | tail -1
}

cmd_status() {
  local now; now=$(date +%s)
  age_h() { [ -f "$1" ] && echo $(( (now - $(cat "$1")) / 3600 )) || echo never; }
  echo "release=$(current_release)"
  echo "previous=$(cat "$ROOT/previous" 2>/dev/null || echo none)"
  for s in "${SERVICES[@]}" caddy postgresql; do echo "$s=$($SYSTEMCTL is-active "$s" 2>/dev/null || true)"; done
  echo "api=$(curl -fsS -o /dev/null -w ok "http://127.0.0.1:${MIDDLEWARE_PORT:-4000}/api/health" 2>/dev/null || echo down)"
  echo "last_backup_hours=$(age_h "$BACKUP_DIR/.last-local")"
  echo "last_offsite_hours=$(age_h "$BACKUP_DIR/.last-offsite")"
  echo "disk_used_pct=$(df --output=pcent / | tail -1 | tr -dc 0-9)"
  echo "tls_mode=$([ -f "$ETC/cloudflare" ] && echo cloudflare || echo letsencrypt)"
  # Faturas-recibo que falharam 6 vezes (o Moloni recusou): a verificação diária avisa
  # Emails que falharam todas as tentativas (Brevo): a verificação diária avisa
  echo "mail_failed=$(as_postgres psql -d "$DB_NAME" -tAc "select count(*) from email_outbox where status = 'failed' and attempts >= 6" 2>/dev/null || echo 0)"
  echo "receipts_stuck=$(as_postgres psql -d "$DB_NAME" -tAc "select count(*) from payments where status = 'paid' and receipt_status = 'failed' and receipt_attempts >= 6" 2>/dev/null || echo 0)"
}

cmd_cf_ips() {
  [ -f "$ETC/cloudflare" ] || die 'Só no modo Cloudflare (bootstrap.sh --cloudflare).'
  local v4 v6 all
  v4=$(curl -fsS https://www.cloudflare.com/ips-v4) && v6=$(curl -fsS https://www.cloudflare.com/ips-v6) || die 'Não consegui obter os IPs da Cloudflare.'
  all=$(printf '%s\n%s\n' "$v4" "$v6" | grep -E '^[0-9a-fA-F:.]+/[0-9]+$')
  [ "$(echo "$all" | wc -l)" -ge 10 ] || die 'Lista de IPs da Cloudflare inesperada.'
  # Caddy: o IP real do visitante vem do cabeçalho Cf-Connecting-IP, mas só destes endereços
  echo "trusted_proxies static $(echo "$all" | tr '\n' ' ')" > /etc/caddy/cloudflare-ips.caddy
  # Firewall: 80/443 só a partir da Cloudflare (as regras antigas são substituídas)
  local n
  while n=$(ufw status numbered | grep -E 'cloudflare$' | head -1 | sed -E 's/^\[ *([0-9]+)\].*/\1/' || true); [ -n "$n" ]; do
    ufw --force delete "$n" >/dev/null
  done
  while read -r net; do
    ufw allow proto tcp from "$net" to any port 80,443 comment cloudflare >/dev/null
    ufw allow proto udp from "$net" to any port 443 comment cloudflare >/dev/null
  done <<< "$all"
  $SYSTEMCTL reload caddy 2>/dev/null || true
  echo "✔ $(echo "$all" | wc -l) redes da Cloudflare autorizadas nas portas 80/443"
}

cmd_oauth() {
  local provider="${1:-}" key id secret
  case "$provider" in google | microsoft) ;; *) die 'Uso: serrado oauth google|microsoft [off]' ;; esac
  key=${provider^^}
  if [ "${2:-}" = off ]; then
    sed -i "/^${key}_CLIENT_\(ID\|SECRET\)=/d" "$ETC/serrado.env"
    $SYSTEMCTL restart serrado-middleware
    echo "✔ Entrada com $provider desativada"
    return
  fi
  read -rp 'Client ID: ' id
  read -rsp 'Client secret (não aparece no ecrã): ' secret; echo
  [[ "$id" =~ ^[A-Za-z0-9._~+/=-]{8,300}$ && "$secret" =~ ^[A-Za-z0-9._~+/=-]{8,300}$ ]] || die 'Client ID ou secret inválido'
  sed -i "/^${key}_CLIENT_\(ID\|SECRET\)=/d" "$ETC/serrado.env"
  printf '%s\n' "${key}_CLIENT_ID=$id" "${key}_CLIENT_SECRET=$secret" >> "$ETC/serrado.env"
  $SYSTEMCTL restart serrado-middleware
  echo "✔ Entrada com $provider ativada. Endereço de retorno a registar no fornecedor:"
  echo "  $(grep '^PUBLIC_URL=' "$ETC/serrado.env" | cut -d= -f2-)/api/v1/auth/oauth/$provider/callback"
}

set_env() {  # set_env CHAVE valor — substitui ou acrescenta em serrado.env
  sed -i "/^$1=/d" "$ETC/serrado.env"
  printf '%s=%s\n' "$1" "$2" >> "$ETC/serrado.env"
}

cmd_facebook() {
  if [ "${1:-}" = off ]; then
    sed -i '/^FACEBOOK_/d' "$ETC/serrado.env"
    $SYSTEMCTL disable --now serrado-facebook.timer 2>/dev/null || true
    echo '✔ Sincronização com o Facebook desligada (as notícias e eventos já importados ficam no site)'
    return
  fi
  local page token mode tag
  read -rp 'ID da página de Facebook (só números): ' page
  read -rsp 'Token da página (não aparece no ecrã): ' token; echo
  read -rp 'Publicar logo no site? [S/n] (n = fica em rascunho para rever): ' mode
  read -rp 'Só publicações com esta hashtag (Enter = todas; ex.: site): ' tag
  [[ $page =~ ^[0-9]{5,25}$ ]] || die 'ID da página inválido'
  [[ $token =~ ^[A-Za-z0-9]{20,1000}$ ]] || die 'Token inválido'
  tag=${tag#\#}
  [[ -z $tag || $tag =~ ^[[:alnum:]_]{1,50}$ ]] || die 'Hashtag inválida'
  set_env FACEBOOK_PAGE_ID "$page"
  set_env FACEBOOK_PAGE_TOKEN "$token"
  set_env FACEBOOK_SYNC_MODE "$([[ $mode =~ ^[nN] ]] && echo draft || echo publish)"
  set_env FACEBOOK_SYNC_TAG "$tag"
  (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.facebook check) || die 'A Meta recusou o token ou o ID da página (ver docs/DEPLOY-VPS.md, secção 5c).'
  $SYSTEMCTL enable --now serrado-facebook.timer
  cmd_facebook_sync
}

cmd_facebook_sync() {
  grep -q '^FACEBOOK_PAGE_TOKEN=' "$ETC/serrado.env" || die 'Facebook ainda não configurado: sudo serrado facebook'
  info 'A sincronizar com a página de Facebook'
  (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.facebook sync)
}

pay_py() { (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.payments "$@"); }

cmd_payments() {
  if [ "${1:-}" = off ]; then
    sed -i '/^STRIPE_/d; /^MOLONI_/d; /^PAYMENT_METHODS=/d' "$ETC/serrado.env"
    $SYSTEMCTL disable --now serrado-receipts.timer serrado-fees.timer 2>/dev/null || true
    $SYSTEMCTL restart serrado-backend serrado-middleware
    echo '✔ Pagamentos online desligados'
    return
  fi
  local sk wh mk company set products methods
  echo '— Stripe (Programadores → Chaves de API e Webhooks)'
  read -rsp 'Chave secreta (sk_live_… ou rk_live_…; não aparece no ecrã): ' sk; echo
  read -rsp 'Segredo do webhook (whsec_…): ' wh; echo
  [[ $sk =~ ^(sk|rk)_(live|test)_[A-Za-z0-9]{10,200}$ ]] || die 'Chave do Stripe inválida'
  [[ $wh =~ ^whsec_[A-Za-z0-9]{10,200}$ ]] || die 'Segredo do webhook inválido'
  set_env STRIPE_SECRET_KEY "$sk"
  set_env STRIPE_WEBHOOK_SECRET "$wh"
  echo '— Moloni ON (Conta → API → API Keys; a empresa precisa do add-on «API Access»)'
  read -rsp 'API Key (apik:…): ' mk; echo
  [[ $mk =~ ^apik:[A-Za-z0-9-]{8,80}:[A-Za-z0-9]{8,200}$ ]] || die 'API Key do Moloni inválida'
  set_env MOLONI_API_KEY "$mk"
  read -rp 'ID da empresa (vazio = mostrar as empresas e sair): ' company
  if [ -z "$company" ]; then $SYSTEMCTL restart serrado-backend; pay_py moloni-info; return; fi
  [[ $company =~ ^[0-9]{1,10}$ ]] || die 'ID da empresa inválido'
  set_env MOLONI_COMPANY_ID "$company"
  pay_py moloni-info || die 'O Moloni recusou a API Key ou a empresa.'
  read -rp 'ID da série para as faturas-recibo: ' set
  read -rp 'Artigos (ex.: quota:123,futsal:456,rugby:789): ' products
  read -rp 'Métodos de pagamento (ex.: card:1,mb_way:2,multibanco:3,cash:4,transfer:5): ' methods
  [[ $set =~ ^[0-9]{1,10}$ ]] || die 'Série inválida'
  [[ $products =~ ^[a-z0-9-]+:[0-9]+(,[a-z0-9-]+:[0-9]+)*$ && $products == *quota:* ]] || die 'Artigos inválidos (tem de ter pelo menos quota:ID)'
  [[ $methods =~ ^[a-z_]+:[0-9]+(,[a-z_]+:[0-9]+)*$ ]] || die 'Métodos inválidos'
  set_env MOLONI_DOCUMENT_SET_ID "$set"
  set_env MOLONI_PRODUCTS "$products"
  set_env MOLONI_PAYMENT_METHODS "$methods"
  $SYSTEMCTL restart serrado-backend serrado-middleware
  $SYSTEMCTL enable --now serrado-receipts.timer serrado-fees.timer
  echo "✔ Pagamentos ligados. Endereço do webhook a registar no Stripe:"
  echo "  $(grep '^PUBLIC_URL=' "$ETC/serrado.env" | cut -d= -f2-)/api/v1/payments/stripe/webhook"
}

cmd_email() {
  case "${1:-}" in
    off)
      sed -i '/^BREVO_API_KEY=/d; /^MAIL_FROM_/d' "$ETC/serrado.env"
      $SYSTEMCTL disable --now serrado-mail.timer 2>/dev/null || true
      $SYSTEMCTL restart serrado-backend serrado-middleware
      echo '✔ Envio de emails desligado («Esqueci-me da password» volta a pedir para contactar a secretaria)'
      return ;;
    test)
      [[ ${2:-} =~ ^[^@[:space:]]+@[^@[:space:]]+\.[a-z]{2,}$ ]] || die 'Uso: serrado email test <endereço>'
      (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.mail test "$2")
      return ;;
  esac
  local key from name
  echo '— Brevo (SMTP e API → Chaves de API). O domínio do remetente tem de estar autenticado (SPF/DKIM) na Brevo.'
  read -rsp 'Chave de API (xkeysib-…; não aparece no ecrã): ' key; echo
  read -rp 'Remetente (ex.: nao-responder@serradofc.pt): ' from
  read -rp 'Nome do remetente [Serrado FC]: ' name
  [[ $key =~ ^xkeysib-[A-Za-z0-9-]{20,200}$ ]] || die 'Chave da Brevo inválida'
  [[ $from =~ ^[^@[:space:]]+@[^@[:space:]]+\.[a-z]{2,}$ ]] || die 'Remetente inválido'
  name=${name:-Serrado FC}
  [[ $name =~ ^[[:alnum:][:space:].-]{2,60}$ ]] || die 'Nome inválido'
  set_env BREVO_API_KEY "$key"
  set_env MAIL_FROM_EMAIL "$from"
  set_env MAIL_FROM_NAME "$name"
  $SYSTEMCTL restart serrado-backend serrado-middleware
  $SYSTEMCTL enable --now serrado-mail.timer
  echo "✔ Emails ligados. Experimenta: sudo serrado email test o-teu@email.pt"
}

case "${1:-}" in
  deploy) shift; cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  backup) shift; cmd_backup "${1:-daily}" ;;
  restore) shift; cmd_restore "$@" ;;
  offsite-latest) shift; cmd_offsite_latest "$@" ;;
  status) cmd_status ;;
  admin) shift; [ $# -eq 2 ] || die 'Uso: serrado admin <email> "<nome>"'; (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.db.create_admin "$1" "$2") ;;
  content) (cd "$ROOT/current/services" && as_app .venv/bin/python -m serrado.db.content) ;;
  logs) journalctl -u serrado-middleware -u serrado-backend -u serrado-facebook -u serrado-receipts -u serrado-fees -u serrado-mail -u caddy -n "${2:-100}" --no-pager ;;
  cf-ips) cmd_cf_ips ;;
  oauth) shift; cmd_oauth "$@" ;;
  facebook) shift; cmd_facebook "$@" ;;
  facebook-sync) cmd_facebook_sync ;;
  payments) shift; cmd_payments "$@" ;;
  moloni-info) pay_py moloni-info ;;
  receipts) pay_py receipts ;;
  fees) shift; [[ -z ${1:-} || $1 =~ ^[0-9]{4}-(0[1-9]|1[0-2])$ ]] || die 'Uso: serrado fees [AAAA-MM]'; pay_py generate-fees "$@" ;;
  email) shift; cmd_email "$@" ;;
  *) sed -n '2,28p' "$0"; exit 1 ;;
esac
