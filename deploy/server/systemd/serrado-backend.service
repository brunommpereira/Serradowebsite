[Unit]
Description=Serrado FC — backend (API interna, 127.0.0.1:4100)
After=network-online.target postgresql.service postgresql.service
Wants=postgresql.service
# Só arranca depois do primeiro deploy
ConditionPathExists=/opt/serrado/current/services/.venv/bin/python

[Service]
User=serrado
Group=serrado
EnvironmentFile=/etc/serrado/serrado.env
Environment=BACKEND_PORT=4100
WorkingDirectory=/opt/serrado/current/services
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/serrado/current/services/.venv/bin/python -m serrado.backend.server
Restart=on-failure
RestartSec=3
MemoryMax=400M
# Isolamento: sem escrita no disco, sem privilégios, só rede IP e o socket do PostgreSQL
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
