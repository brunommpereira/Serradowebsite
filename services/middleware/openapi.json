{
  "openapi": "3.0.3",
  "info": {
    "title": "Serrado FC — Middleware (API pública)",
    "version": "1.0.0",
    "description": "API consumida pelo front. Sessão por cookie httpOnly (sfc_session) ou Authorization: Bearer."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sfc_session"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "summary": "Entrar (email ou n.º de sócio). Define o cookie de sessão httpOnly.",
        "tags": [
          "Sessão"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "password"
                ],
                "properties": {
                  "login": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Terminar sessão",
        "tags": [
          "Sessão"
