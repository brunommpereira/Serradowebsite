{
  "name": "serrado-services",
  "private": true,
  "type": "module",
  "description": "Middleware (API pública /api/v1) e backend (API interna /internal/v1) do Serrado FC Digital",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "db:migrate": "node db/migrate.ts",
    "db:seed": "node db/seed/seed.ts",
    "db:content": "node db/seed/content.ts",
    "db:create-admin": "node db/create-admin.ts",
    "backend": "node backend/src/server.ts",
    "middleware": "node middleware/src/server.ts",
    "openapi": "node scripts/openapi.ts",
    "test": "node --test --test-concurrency=1 db/test/*.test.ts backend/test/*.test.ts middleware/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9"
  }
}
